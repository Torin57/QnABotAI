# Шаблон переменных окружения (без секретов).
# Не копируйте этот файл целиком — используйте шаблоны окружений ниже.
#
# Куда класть секреты:
#   development → .env.development.local  (см. .env.development.example)
#   staging     → .env.staging.local      (см. .env.staging.example)
#   production  → .env.production.local   (см. .env.production.example)
#
# Общие несекретные значения (хост Qdrant, порт) можно оставить здесь или в .env.local.

# --- Telegram ---
# TG_BOT_TOKEN=          # отдельный бот на каждое окружение (см. .env.*.example)

# --- Mistral ---
# MISTRAL_API_KEY=

# --- Qdrant (по умолчанию localhost) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- HTTP ---
# PORT=3000

# --- Админка ---
# ADMIN_PASSWORD_HASH_BASE64=   # npm run admin:hash-password -- "пароль"
# SESSION_SECRET=               # openssl rand -hex 32
