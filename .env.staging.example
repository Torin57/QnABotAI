# Staging (предпрод): скопируйте в .env.staging.local на staging-сервере
# cp .env.staging.example .env.staging.local
#
# Запуск: APP_ENV=staging NODE_ENV=production npm start
#
# Отдельный Telegram-бот для staging — не пересекается с dev и prod.

APP_ENV=staging
DATABASE_PATH=data/logs-staging.db
QDRANT_COLLECTION=qna_staging

TG_BOT_TOKEN=your_staging_telegram_bot_token_here
MISTRAL_API_KEY=your_mistral_api_key_here

ADMIN_PASSWORD_HASH_BASE64=
SESSION_SECRET=

# Ссылка на чат с преподавателем — показывается в кнопке, когда бот не нашёл ответ
TEACHER_CONTACT_URL=https://t.me/your_staging_teacher_contact

# QDRANT_HOST=
# QDRANT_PORT=6333
# PORT=3000
