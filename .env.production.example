# Production: скопируйте в .env.production.local на prod-сервере
# cp .env.production.example .env.production.local
#
# Запуск: npm start  (APP_ENV=production, NODE_ENV=production)
#
# ВАЖНО: ОБЯЗАТЕЛЬНО отдельный Telegram-бот для production.
# Создайте через @BotFather (например «MyCourse FAQ») — dev/staging токены сюда не класть.
# SESSION_SECRET и пароль админки — свои, не как в dev.

APP_ENV=production
DATABASE_PATH=data/logs-prod.db
QDRANT_COLLECTION=qna_prod

TG_BOT_TOKEN=your_production_telegram_bot_token_here
MISTRAL_API_KEY=your_mistral_api_key_here

ADMIN_PASSWORD_HASH_BASE64=
SESSION_SECRET=

# Ссылка на чат с преподавателем — показывается в кнопке, когда бот не нашёл ответ
TEACHER_CONTACT_URL=https://t.me/your_teacher_contact

# QDRANT_HOST=
# QDRANT_PORT=6333
# PORT=3000
