# Локальная разработка: скопируйте в .env.development.local
# cp .env.development.example .env.development.local
#
# Запуск: npm run dev:server  (APP_ENV=development по умолчанию)
#
# ВАЖНО: используйте ОТДЕЛЬНЫЙ Telegram-бот для dev — не prod-токен.
# Создайте бота через @BotFather с именем вроде «MyCourse FAQ (dev)».

APP_ENV=development

TG_BOT_TOKEN=your_dev_telegram_bot_token_here
MISTRAL_API_KEY=your_mistral_api_key_here

ADMIN_PASSWORD_HASH_BASE64=
SESSION_SECRET=

# Ссылка на чат с преподавателем — показывается в кнопке, когда бот не нашёл ответ
TEACHER_CONTACT_URL=https://t.me/your_dev_teacher_contact

# Опционально — можно переопределить Qdrant
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# PORT=3000
